# Database
DATABASE_URL=sqlite+aiosqlite:///./data/policy_collector.db

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Application
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Government Domain Whitelist (comma-separated)
GOV_DOMAINS=gov.cn,mof.gov.cn,mohurd.gov.cn,miit.gov.cn,most.gov.cn,moe.gov.cn,nhc.gov.cn,gov.cn

# Policy Search
SEARCH_LIMIT=10
SEARCH_OFFSET=0
POLICY_YEARS_LIMIT=5
